# AGROVERSE AI Environment Variables Configuration
# Copy this file to .env for local overrides

# Node Express Backend Server Port
PORT=5000

# API Base URL for Frontend Services
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Authentication & Cloud Firestore Credentials
# Get these keys from https://console.firebase.google.com -> Project Settings -> Web App
VITE_FIREBASE_API_KEY=AIzaSy...your_real_api_key_here...
VITE_FIREBASE_AUTH_DOMAIN=your-app-name.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-name.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123def

# Optional Satellite / Weather External API Keys
# VITE_SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id_here
# VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
